# Required: EOS Online ID copied from the Dragonwilds game client, NOT Steam ID.
RSDW_OWNER_ID=
RSDW_SERVER_NAME=Dragonwilds Pi
RSDW_WORLD_NAME=MyWorld
# Empty join password means open access. Use a fixed value for a private world.
RSDW_PASSWORD=
RSDW_ADMIN_PASSWORD=
# Optional: skip the download/update check when game files already exist.
RSDW_SKIP_UPDATE=false
